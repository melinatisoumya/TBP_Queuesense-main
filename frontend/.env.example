# Copy to .env and set to your backend (the PC running `npm start` in /backend).
# Use the PC's LAN IP (not localhost) so patients' phones can reach it too.
VITE_API_URL=http://192.168.1.20:3001
# Address encoded in the OP-desk QR code (where phones open this web app).
# For `npm run dev --host` this is typically http://<PC-LAN-IP>:5173
VITE_PUBLIC_URL=http://192.168.1.20:5173
